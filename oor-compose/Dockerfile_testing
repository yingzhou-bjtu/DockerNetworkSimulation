FROM ubuntu:22.04
MAINTAINER alopez@ac.upc.edu
ENV TERM=xterm
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -y && \
    apt-get install -y \
    build-essential \
    git \
    libconfuse-dev \
    gengetopt \
    libcap2-bin \
    libzmq3-dev \
    libxml2-dev \
    iputils-ping && \
    apt-get autoclean && \
    apt-get autoremove

RUN git clone https://github.com/OpenOverlayRouter/oor.git -b testing
WORKDIR /oor
RUN make
RUN make install
RUN rm -rf /oor
COPY files/*.sh /tmp/

# 设置一些环境变量用于测试启动脚本
ENV DEBUG 0
ENV OPMODE xTR
ENV IPMAPRESOLVER -
ENV IPMAPSERVER -
ENV KEYMAPSERVER -
ENV IPPROXYETRV4 -
ENV IPPROXYETRV6 -
ENV IPV4EIDPREFFIX -
ENV IPV6EIDPREFFIX -

# 运行启动脚本，传递相关参数
CMD /tmp/start_testing.sh $DEBUG $OPMODE $IPMAPRESOLVER $IPMAPSERVER $KEYMAPSERVER $IPPROXYETRV4 $IPPROXYETRV6 $IPV4EIDPREFFIX $IPV6EIDPREFFIX

